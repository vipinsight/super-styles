{
	"name": "Super Styles",
	"version": "1.1.0",
	"manifest_version": 3,
	"author": "Vipin Yadav",
	"homepage_url": "https://vipinyadav.com/",
	"description": "Write custom CSS/JS to any websites",
	"action": {
		"default_icon": "img/logo-32.png",
		"default_popup": "popup.html"
	},
	"background": {
		"service_worker": "background.js"
	},
	"permissions": [
		"tabs",
		"storage",
		"scripting",
		"offscreen"
	],
	"host_permissions": [
		"http://*/*",
		"https://*/*"
	],
	"icons": {
		"16": "img/logo-16.png",
		"32": "img/logo-32.png",
		"48": "img/logo-48.png",
		"64": "img/logo-64.png",
		"128": "img/logo-128.png",
		"256": "img/logo.png"
	}
}